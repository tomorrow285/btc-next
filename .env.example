# 复制为 .env 后填写。.env 已被 .gitignore 忽略。
# 所有配置项都有默认值；没有任何密钥也能启动只读命令（board/status），
# 但 account / trade / live 需要 BINANCE_API_KEY / BINANCE_API_SECRET。
#
# 本项目只支持：btc-15m 盘口 + B0 跟盘策略。
# 日志固定为单行 JSON（UTC ISO 时间 + event），不再提供 LOG_FORMAT 开关。

# ========== 币安凭据 ==========
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ========== 接口地址 ==========
BINANCE_BASE_URL=https://api.binance.com
PREDICTION_WEB_BASE=https://web3.binance.com/bapi/defi/v1/public/wallet-direct/prediction/web
PREDICTION_VENDOR=PREDICT_FUN
PREDICTION_WEB_ORIGIN=https://web3.binance.com
PREDICTION_WEB_REFERER=https://web3.binance.com/zh-CN/prediction/live
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/131.0.0.0 Safari/537.36

# 签名接口超时与幂等读请求的重试次数（下单永不使用传输层重试）
HTTP_TIMEOUT_MS=20000
HTTP_RETRIES=2

# ========== 盘口 ==========
SPOT_SYMBOL=BTCUSDT
# market/list 每页条数；首次找锚点最多翻几页（找到后会写入 data/market-list.json）
MARKET_LIST_PAGE_SIZE=100
MARKET_LIST_MAX_PAGES=4

# ========== 执行器时间节点（单位：秒） ==========
# 开盘后多少秒入场
ENTRY_DELAY_S=20
# 超过入场时点这么久就放弃本窗口
ENTRY_WINDOW_S=40
# 收盘后等多久读盘面自判
JUDGE_DELAY_S=5
# 自判读盘面的重试预算（超了挂待复核）
JUDGE_BUDGET_S=10
# 自判硬截止：最晚等到「盘面结束 + 该秒数」就放弃，不论预算还剩多少（超了挂待复核）
JUDGE_DEADLINE_S=15
# 入场前留给下单路径（取窗口/盘口/报价/下单）的预留
ORDER_RESERVE_S=5
# 补结算（链上对账）的单次预算
RECONCILE_BUDGET_S=30
# 单笔链上结算记录的等待上限
CHAIN_QUERY_TIMEOUT_S=20
# 待补的注最多尝试多少次后收口
CATCHUP_MAX_TRIES=2

# ========== 下单 ==========
SLIPPAGE_BPS=200
# 下单只提交一次，不做重试；这里是下单后回查订单终态的等待上限（毫秒）
ORDER_CONFIRM_TIMEOUT_MS=20000

# ========== 策略 B0（跟盘 + 马丁格尔） ==========
# 手续费率（按份额扣；默认 2%）
FEE_RATE=0.02
# 有效倍率门槛：按盘口深度算出的有效倍率 < 该值一律不下单（默认 1.3）
MIN_EFFECTIVE_MULTIPLIER=1.3
# 基础注码
B0_BASE_PRICE=1
# 保守模式：连败 ≥ B0_RISK_COUNT 或 TOTAL_LOSS ≥ B0_RISK_AMOUNT 时去掉基础利润
B0_RISK_AMOUNT=10
B0_RISK_COUNT=3
# 重新初始化：连败 ≥ 该次数，或 TOTAL_LOSS ≥ B0_BASE_PRICE × 该倍数
B0_RESET_LOSS_STREAK=15
B0_RESET_LOSS_MULTIPLE=128

# ========== 飞书通知（可选） ==========
# 自建应用直发会话，不依赖 Hermes / 任何第三方网关。
# 三项凭据要么全填、要么全不填；只填一半会在启动时报错。
# 不填时通知整体静默，交易与只读命令照常运行。
# 自检链路：pnpm notice "测试消息"   只查配置：pnpm notice --check
# Lark 国际版填 https://open.larksuite.com/open-apis
FEISHU_API_BASE=https://open.feishu.cn/open-apis
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 群聊是 oc_ 开头（receive_id_type=chat_id）；私聊可用 open_id / user_id / email
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_ID_TYPE=chat_id
# 总开关；凭据齐全时默认启用
FEISHU_NOTIFY_ENABLED=true
# 单条消息的发送尝试次数（含首次）与单次超时
FEISHU_RETRIES=3
FEISHU_TIMEOUT_MS=10000
# 同一去重键的冷却时间（毫秒）：默认 30 分钟，避免同类跳过原因每 15 分钟刷一次
FEISHU_DEDUPE_MS=1800000

# ========== 其它 ==========
# 状态 / 流水 / 缓存 / 暂停标记目录；相对路径按项目根目录解析
DATA_DIR=data
